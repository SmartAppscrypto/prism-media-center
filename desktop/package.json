{
  "name": "@prism/desktop",
  "private": true,
  "type": "module",
  "version": "0.14.2",
  "description": "Prism desktop media client",
  "author": "Prism Media",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop": "electron .",
    "native:build": "node scripts/build-native.mjs",
    "vlc:prepare": "node scripts/prepare-vlc-runtime.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "package:mac": "npm run native:build && npm run vlc:prepare && npm run build && electron-builder --mac dmg --publish never",
    "package:windows": "npm run native:build && npm run vlc:prepare && npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "hls.js": "^1.6.13",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^26.1.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "43.2.0",
    "electron-builder": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "media.prism.desktop",
    "productName": "Prism",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/native/build/Release/*.node"
    ],
    "extraResources": [
      {
        "from": "vendor/vlc",
        "to": "vlc",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "identity": null,
      "icon": "build/icon.icns",
      "artifactName": "Prism-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Prism-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
