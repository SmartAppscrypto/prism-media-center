# Defaults are local-only. For another device, use this server's own LAN IP.
PRISM_BIND_ADDRESS=127.0.0.1
TZ=Etc/UTC
# Relative to this folder. Forward slashes work on Windows: C:/Users/you/Videos
MEDIA_PATH=./media
HOME_VIDEOS_PATH=./media/Home Videos
JELLYFIN_HOME_VIDEOS_PATH=/media/Home Videos
# Optional artwork profile: an unprivileged UID/GID with write access to Home Videos.
ARTWORK_UID=1000
ARTWORK_GID=1000
